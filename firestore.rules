rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Items collection - users can only access their own items
    match /items/{itemId} {
      // Allow read if user is signed in and is the owner, or if document doesn't exist yet (for list queries)
      allow read: if isSignedIn() && (resource.data.createdBy == request.auth.uid || request.resource.data.createdBy == request.auth.uid);
      
      // Allow create if user is signed in and createdBy is set to their uid
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      
      // Allow update if user is signed in and is the owner
      allow update: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      
      // Allow delete if user is signed in and is the owner
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      
      // Allow list operations for signed-in users
      allow list: if isSignedIn();
    }
    
    // Sales collection - users can only access their own sales
    match /sales/{saleId} {
      // Allow read if user is signed in and is the owner
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      
      // Allow create if user is signed in and userId is set to their uid
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // Allow update if user is signed in and is the owner
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Allow delete if user is signed in and is the owner
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Allow list operations for signed-in users
      allow list: if isSignedIn();
    }
    
    // Expenses collection - users can only access their own expenses
    match /expenses/{expenseId} {
      // Allow read if user is signed in and is the owner
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      
      // Allow create if user is signed in and userId is set to their uid
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // Allow update if user is signed in and is the owner
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Allow delete if user is signed in and is the owner
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Allow list operations for signed-in users
      allow list: if isSignedIn();
    }
    
    // Purchases collection - users can only access their own purchases
    match /purchases/{purchaseId} {
      // Allow read if user is signed in and is the owner
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      
      // Allow create if user is signed in and userId is set to their uid
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // Allow update if user is signed in and is the owner
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Allow delete if user is signed in and is the owner
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Allow list operations for signed-in users
      allow list: if isSignedIn();
    }
    
    // Activity logs - users can only read their own logs
    match /activityLogs/{logId} {
      // Allow read if user is signed in and is the owner
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Allow create for signed-in users (application-level control)
      allow create: if isSignedIn();
      
      // Logs should not be modified or deleted
      allow update, delete: if false;
      
      // Allow list operations for signed-in users
      allow list: if isSignedIn();
    }
  }
}

